          "cachedResultName": "gpt-5-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a translator for delivery status messages. Translate the driver message into the target language. Preserve the exact meaning. Do NOT change or translate names, order IDs, product names, locations, or numbers. Return only the translated sentence with no extra commentary."
            },
            {
              "content": "=Target language: {{ $(\"Get Receiver Language\").item.json.receiver_language || \"English\" }}\n\nDriver message: {{ $(\"Transcribe a recording1\").item.json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "42bf60bb-8a4e-42e5-a22b-6eb2b2b5a66a",
      "name": "Translate Message",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        2880,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "mjupgpRJqk0CWrq5",
          "name": "n8n free OpenAI API credits"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $('Webhook').item.json.body || {};\n\nconst transcript = $('Transcribe a recording1').item.json.text || '';\n\nlet classified = {};\ntry {\n  const c = $('Classify Message').item.json.output[0].content[0].text;\n  classified = (typeof c === 'string') ? JSON.parse(c) : (c || {});\n} catch (e) { classified = {}; }\n\nlet translated = '';\nlet translation_status = 'success';\ntry {\n  const t = $('Translate Message').item.json.output;\n  if (t && t[0] && t[0].content && t[0].content[0] && t[0].content[0].text) {\n    translated = t[0].content[0].text.toString();\n  }\n} catch (e) { translated = ''; }\nif (!translated) { translated = transcript; translation_status = 'failed'; }\n\nconst receiver = $('Get Receiver Language').item.json || {};\n\nconst message_id = (typeof crypto !== 'undefined' && crypto.randomUUID)\n  ? crypto.randomUUID()\n  : 'msg_' + Date.now() + '_' + Math.floor(Math.random() * 1e6);\n\nconst order_id = (body.order_id || classified.order_id || receiver.order_id || '').toString();\n\nreturn [{\n  json: {\n    message_id,\n    order_id,\n    delivery_person_id: (body.delivery_person_id || '').toString(),\n    original_audio_reference: (body.audio_reference || body.audio_url || '').toString(),\n    transcribed_text: transcript,\n    detected_language: (classified.detected_language || '').toString(),\n   delivery_status: (classified.delivery_status || 'OTHER').toString(),\n    driver_message: (classified.driver_message || transcript).toString(),\n    translated_text: translated,\n    receiver_language: (receiver.receiver_language || 'English').toString(),\n    receiver_email: (receiver.receiver_email || '').toString(),\n    receiver_name: (receiver.receiver_name || '').toString(),\n    latitude: (body.latitude != null ? body.latitude : '').toString(),\n    longitude: (body.longitude != null ? body.longitude : '').toString(),\n    translation_status,\n    confidence: (classified.confidence || 0.95).toString(),\n    processing_status: 'processed',\n    event_timestamp: new Date().toISOString(),\n  }\n}];\n"
      },
