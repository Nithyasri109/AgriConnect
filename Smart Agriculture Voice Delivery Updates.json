    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You analyse short delivery-driver voice transcripts for a smart agriculture logistics system.\n\nDetect the language of the delivery driver's transcript itself. Do NOT use the receiver's preferred language.\ndetected_language must be the full English name of the language (e.g. Tamil, English, Hindi, Malayalam, Telugu, Kannada).\n\nTranslate the transcript verbatim to English. Store this in english_translation.\n\nPerform semantic intent classification on the English translation. Do NOT use simple keyword matching.\nAccount for negation, future/past tense, synonyms, and context.\n\nClassify the status into one of these exact statuses:\n- DELIVERED: Used ONLY if the message indicates the package has been successfully delivered and handed over now (e.g., 'Order delivered successfully', 'The order has been delivered', 'Customer received the parcel', 'I handed over the package').\n- ARRIVED: The driver has reached the destination (e.g., 'I reached the customer location', 'I have arrived').\n- OUT_FOR_DELIVERY: The driver is en route (e.g., 'I am on the way', 'I will deliver tomorrow').\n- PICKED_UP: Driver collected package from the farm (e.g., 'I picked up the package').\n- FAILED: Delivery failed (e.g., 'Delivery failed').\n- UNKNOWN: Negations or unsuccessful attempts (e.g., 'The order is NOT delivered', 'I couldn't deliver', 'Customer was unavailable').\n\nconfidence must be a decimal score between 0.0 and 1.0 representing classification confidence.\n\nReturn ONLY the requested JSON schema."
            },
            {
              "content": "=Transcript: {{ $(\"Transcribe a recording1\").item.json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "delivery_classification",
              "schema": "={ JSON.stringify({\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"delivery_status\", \"detected_language\", \"order_id\", \"driver_message\", \"english_translation\", \"confidence\"], \"properties\": {\"delivery_status\": {\"type\": \"string\", \"enum\": [\"DELIVERED\", \"ARRIVED\", \"OUT_FOR_DELIVERY\", \"PICKED_UP\", \"FAILED\", \"UNKNOWN\"]}, \"detected_language\": {\"type\": \"string\"}, \"order_id\": {\"type\": \"string\"}, \"driver_message\": {\"type\": \"string\"}, \"english_translation\": {\"type\": \"string\"}, \"confidence\": {\"type\": \"number\"}}}) }",
              "strict": true
            }
          }
        }
      },
      "id": "7335f092-2140-465f-91b5-e6506ee691f7",
